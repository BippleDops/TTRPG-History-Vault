# Obsidian workspace files (user-specific)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.backup

# Obsidian cache
.obsidian/cache/

# Trash folder
.trash/
.Trash/

# macOS system files
.DS_Store
Thumbs.db

# Windows system files
desktop.ini

# Temporary files
*.tmp
*.temp
*~

# Sync conflicts
*conflicted copy*

# Vendored community-plugin bundles (re-downloaded by Obsidian from
# .obsidian/community-plugins.json; keep manifest.json and data.json)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
