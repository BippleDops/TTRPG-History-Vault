# Obsidian workspace files (user-specific)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.backup

# Obsidian cache
.obsidian/cache/

# Trash folder
.trash/
.Trash/

# macOS system files
.DS_Store
Thumbs.db

# Windows system files
desktop.ini

# Temporary files
*.tmp
*.temp
*~

# Sync conflicts
*conflicted copy*

# Vendored community-plugin bundles (re-downloaded by Obsidian from
# .obsidian/community-plugins.json; keep manifest.json and data.json)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Python bytecode from Scripts/
__pycache__/
*.pyc

# Reports generated by the validators (CI uploads them as artifacts)
validation-report.md
schema-report.md
link-report.md
reciprocal-links-report.md
reciprocal-report.md

# Script outputs
Exports/
